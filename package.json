{
  "name": "@warren-bank/Android-ExoPlayer-AirPlay-Receiver",
  "private": true,
  "license": "GPL-2.0",
  "devDependencies": {
    "@warren-bank/translate-android-strings": "^3.0.1"
  },
  "scripts": {
    "translate:strings":      "translate-android-strings -s \"deepl\" -i \"en\" -f \"android-studio-project/ExoPlayer-AirPlay-Receiver/src/main/res/values/strings.xml\"                        -d \"android-studio-project/ExoPlayer-AirPlay-Receiver/src/withAllLanguageTranslations/res\" -m --nc --nw --nr -b \"(?:ExoAirPlayer|ExoPlayer|AirPlay|Bonjour|mDNS|HTTP|API|DRM|\\((?:\\*|dB|ms)\\)|\\d+%|x TsExtractor.DEFAULT_TIMESTAMP_SEARCH_BYTES|HDMV DTS|AC3 Dolby Digital|PCM|KeyCode)\"",
    "translate:dialog:track": "translate-android-strings -s \"deepl\" -i \"en\" -f \"android-studio-project/ExoPlayer-AirPlay-Receiver/src/main/res/values/track_selection_dialog.xml\"         -d \"android-studio-project/ExoPlayer-AirPlay-Receiver/src/withAllLanguageTranslations/res\" -m --nc --nw --nr",
    "translate:dialog:time":  "translate-android-strings -s \"deepl\" -i \"en\" -f \"android-studio-project/ExoPlayer-AirPlay-Receiver/src/main/res/values/multi_field_time_picker_dialog.xml\" -d \"android-studio-project/ExoPlayer-AirPlay-Receiver/src/withAllLanguageTranslations/res\" -m --nc --nw --nr",
    "translate:all": "npm run translate:strings && npm run translate:dialog:track && npm run translate:dialog:time",

    "translate:debug:strings":      "npm run translate:strings      -- -o \"en\" --debug",
    "translate:debug:dialog:track": "npm run translate:dialog:track -- -o \"en\" --debug",
    "translate:debug:dialog:time":  "npm run translate:dialog:time  -- -o \"en\" --debug",
    "translate:debug:all": "npm run translate:debug:strings && npm run translate:debug:dialog:track && npm run translate:debug:dialog:time"
  }
}
